# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# storybook
/storybook-static
*storybook.log

# playwright
/playwright-report
/test-results

# local tool settings & caches (personal, not shared)
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/hook.cache.json

# The supplied LEVRRO brand-identity microsite. A local reference drop, not
# project source: a separate Vite app with its own dependencies and lockfile.
# It is the provenance for the navy/teal palette and the Poppins pairing, and
# those values are recorded in DESIGN.md and lib/design/tokens.ts — which is
# where they belong. tsconfig and eslint exclude the folder so that a copy
# sitting in the working tree is never compiled or linted.
levrro-brand-identity-clone/
